-        .map_err(|_| einval())?;
+        let mut bytes = data.path()?.into_bytes();
+        bytes.push(b'/');
+        bytes.extend_from_slice(name.to_bytes());
+        let cstr = CString::new(bytes).map_err(|_| einval())?;
         debug!("name_to_path: path={}", cstr.to_string_lossy());
         Ok(cstr)
     }
@@ -1374,6 +1417,7 @@ impl FileSystem for PassthroughFs {
                 inode: fuse::ROOT_ID,
                 ino: st.st_ino,
                 dev: st.st_dev,
+                path_fd: if InodeData::supports_volfs(&st) { None } else { Some(f) },
                 refcount: AtomicU64::new(2),
                 unlinked_fd: AtomicI64::new(-1),
             }),
@@ -1456,6 +1500,16 @@ impl FileSystem for PassthroughFs {
             // There is a possible race here where 2 threads end up adding the same file
             // into the inode list.  However, since each of those will get a unique Inode
             // value and unique file descriptors this shouldn't be that much of a problem.
+            let needs_path = if st.st_dev == parent_data.dev {
+                parent_data.path_fd.is_some()
+            } else {
+                !InodeData::supports_volfs(&st)
+            };
+            let path_fd = if needs_path {
+                Some(InodeData::remember_path(&c_path, &st)?)
+            } else {
+                None
+            };
             let inode = self.inode_alloc.next();
             self.inodes.write().unwrap().insert(
                 inode,
@@ -1467,6 +1521,7 @@ impl FileSystem for PassthroughFs {
                     inode,
                     ino: st.st_ino,
                     dev: st.st_dev,
+                    path_fd,
                     refcount: AtomicU64::new(1),
                     unlinked_fd: AtomicI64::new(-1),
                 }),
diff --git a/src/devices/src/virtio/linux_errno.rs b/src/devices/src/virtio/linux_errno.rs
index 105f977..6f5062b 100644
--- a/src/devices/src/virtio/linux_errno.rs
+++ b/src/devices/src/virtio/linux_errno.rs
@@ -177,6 +177,10 @@ pub fn linux_errno_raw(errno: i32) -> i32 {
         libc::ENOSTR => LINUX_ENOSTR,
         libc::EPROTO => LINUX_EPROTO,
         libc::ETIME => LINUX_ETIME,
+        // Darwin file systems return ENOTSUP for unsupported operations such as
+        // exclusive rename on exFAT. Darwin's socket EOPNOTSUPP is distinct.
+        #[cfg(target_os = "macos")]
