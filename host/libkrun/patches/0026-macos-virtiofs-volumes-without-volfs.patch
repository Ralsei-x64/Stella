Subject: [PATCH] macos: support virtio-fs on volumes without volfs inode paths

exFAT can return valid stat information for an entry while /.vol/dev/ino
returns ENOENT. Hold a vnode reference for each active lookup on these
volumes, resolve its current path for operations, and release it with the
FUSE inode. Filesystems with native inode paths retain their existing fast path.

diff --git a/src/devices/src/virtio/fs/macos/passthrough.rs b/src/devices/src/virtio/fs/macos/passthrough.rs
index 16d5bbb..03b3fee 100644
--- a/src/devices/src/virtio/fs/macos/passthrough.rs
+++ b/src/devices/src/virtio/fs/macos/passthrough.rs
@@ -56,6 +56,56 @@ struct InodeData {
     dev: i32,
     refcount: AtomicU64,
     unlinked_fd: AtomicI64,
+    // File systems without volfs inode paths (e.g. exFAT) need a vnode reference
+    // to find the current path after a guest or Finder rename.
+    path_fd: Option<File>,
+}
+
+impl InodeData {
+    fn volfs_path(dev: i32, ino: u64) -> CString {
+        CString::new(format!("/.vol/{dev}/{ino}")).unwrap()
+    }
+
+    fn supports_volfs(st: &bindings::stat64) -> bool {
+        let path = Self::volfs_path(st.st_dev, st.st_ino);
+        let mut found = MaybeUninit::<bindings::stat64>::zeroed();
+        // Check the identity as well as existence before relying on the alias.
+        if unsafe { libc::lstat(path.as_ptr(), found.as_mut_ptr()) } != 0 {
+            return false;
+        }
+        let found = unsafe { found.assume_init() };
+        found.st_dev == st.st_dev && found.st_ino == st.st_ino
+    }
+
+    fn path(&self) -> io::Result<CString> {
+        let Some(file) = &self.path_fd else {
+            return Ok(Self::volfs_path(self.dev, self.ino));
+        };
+        let mut buf = [0 as libc::c_char; libc::MAXPATHLEN as usize];
+        if unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETPATH, buf.as_mut_ptr()) } < 0 {
+            return Err(linux_error(io::Error::last_os_error()));
+        }
+        Ok(unsafe { CStr::from_ptr(buf.as_ptr()) }.to_owned())
+    }
+
+    fn remember_path(path: &CStr, st: &bindings::stat64) -> io::Result<File> {
+        // O_SYMLINK holds the link itself. O_EVTONLY also works for directories
+        // and files that the user may stat but cannot open for reading.
+        let fd = unsafe { libc::open(path.as_ptr(), libc::O_EVTONLY | libc::O_SYMLINK | libc::O_CLOEXEC) };
+        if fd < 0 {
+            return Err(linux_error(io::Error::last_os_error()));
+        }
+        let file = unsafe { File::from_raw_fd(fd) };
+        let mut actual = MaybeUninit::<bindings::stat64>::zeroed();
+        if unsafe { libc::fstat(fd, actual.as_mut_ptr()) } != 0 {
+            return Err(linux_error(io::Error::last_os_error()));
+        }
+        let actual = unsafe { actual.assume_init() };
+        if actual.st_dev != st.st_dev || actual.st_ino != st.st_ino {
+            return Err(linux_error(io::Error::from_raw_os_error(libc::ESTALE)));
+        }
+        Ok(file)
+    }
 }
 
