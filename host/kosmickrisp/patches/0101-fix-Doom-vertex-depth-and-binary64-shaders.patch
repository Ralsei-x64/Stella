+      NIR_PASS(_, nir, nir_propagate_invariant, true);
+   }
    msl_preprocess_nir(nir);
 
    /* Cannot be part of msl_preprocess_nir since clc does not expose
@@ -1108,6 +1111,7 @@ kk_compile_msl(struct kk_physical_device *pdev, nir_shader *nir,
    struct nir_to_msl_options translate_options = {
       .mem_ctx = NULL,
       .disabled_workarounds = pdev->settings.disabled_workarounds,
+      .invariant_position = nir->info.stage == MESA_SHADER_VERTEX && kk_doom_invariant_position(&pdev->vk),
    };
    if (nir->info.stage == MESA_SHADER_FRAGMENT) {
       for (uint32_t i = 0u; i < MAX_DRAW_BUFFERS; ++i) {
@@ -1770,7 +1774,7 @@ kk_metal_caches_finish(struct kk_device *dev)
  * Returns a reference the caller releases, like mtl_new_library does, and the
  * source's digest, which names the library in the pipeline keys. */
 static mtl_library *
-kk_get_msl_library(struct kk_device *device, const char *source,
+kk_get_msl_library(struct kk_device *device, const char *source, bool vertex,
                    blake3_hash source_digest)
 {
    _mesa_blake3_compute(source, strlen(source), source_digest);
@@ -1785,9 +1789,11 @@ kk_get_msl_library(struct kk_device *device, const char *source,
       return library;
 
    struct kk_physical_device *pdev = kk_device_physical(device);
-   library = mtl_new_library(device->mtl_compiler_handle, source,
-                             pdev->info.msl_version, MTL_MATH_MODE_FAST,
-                             MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
+   const bool invariant = vertex && kk_doom_invariant_position(&pdev->vk);
+   library = mtl_new_library(device->mtl_compiler_handle, source, pdev->info.msl_version,
+                             invariant ? MTL_MATH_MODE_SAFE : MTL_MATH_MODE_FAST,
+                             invariant ? MTL_MATH_FLOATING_POINT_FUNCTIONS_PRECISE :
+                                         MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
    /* Takes the key, which this caller no longer owns */
    kk_metal_cache_publish(&device->msl_libraries, key, library);
    return library;
@@ -1800,7 +1806,7 @@ kk_compile_compute_pipeline(struct kk_device *device, mtl_compiler *compiler,
                             mtl_compute_pipeline_state **pipe)
 {
    blake3_hash source;
