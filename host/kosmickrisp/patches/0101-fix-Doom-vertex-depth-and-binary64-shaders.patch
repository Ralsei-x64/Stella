diff --git a/src/kosmickrisp/compiler/kk_soft_fp64_library.c b/src/kosmickrisp/compiler/kk_soft_fp64_library.c
new file mode 100644
index 0000000..d2e85cf
--- /dev/null
+++ b/src/kosmickrisp/compiler/kk_soft_fp64_library.c
@@ -0,0 +1,136 @@
