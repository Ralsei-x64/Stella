diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index 15c505b..c27b306 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -5,6 +5,7 @@
  */
 
 #include "nir_to_msl.h"
+#include "kk_soft_fp64_library.h"
 #include "msl_private.h"
 #include "nir.h"
 #include "nir_builder.h"
@@ -2804,6 +2805,22 @@ msl_preprocess_nir(struct nir_shader *nir)
    NIR_PASS(_, nir, nir_split_per_member_structs);
    NIR_PASS(_, nir, nir_lower_continue_constructs);
 
+   if (nir->info.bit_sizes_float & 64) {
+      /* Metal has no binary64 ALU. Keep real binary64 intermediate results
+       * in integer registers using Mesa's immutable soft-float library. */
+      const nir_shader *library = kk_soft_fp64_library(nir->options);
+      bool progress = library != NULL;
+      while (progress) {
+         progress = false;
+         NIR_PASS(progress, nir, nir_lower_doubles, library,
+                  (nir_lower_doubles_options)~0u);
+         NIR_PASS(_, nir, nir_opt_deref);
+         NIR_PASS(_, nir, nir_lower_vars_to_ssa);
+         NIR_PASS(_, nir, nir_opt_copy_prop);
+         NIR_PASS(_, nir, nir_opt_dce);
+      }
+      NIR_PASS(_, nir, nir_lower_continue_constructs);
+   }
    NIR_PASS(_, nir, nir_lower_frexp);
 
    NIR_PASS(_, nir, nir_lower_vars_to_ssa);
@@ -3237,6 +3254,7 @@ nir_to_msl(nir_shader *shader, struct nir_to_msl_options *options)
       .shader = shader,
       .text = _mesa_string_buffer_create(options->mem_ctx, 1024),
       .disabled_workarounds = options->disabled_workarounds,
+      .invariant_position = options->invariant_position,
    };
    nir_function_impl *impl = nir_shader_get_entrypoint(shader);
    msl_gather_info(&ctx, options);
