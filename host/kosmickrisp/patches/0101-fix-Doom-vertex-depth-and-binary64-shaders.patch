+bool
+kk_doom_invariant_position(const struct vk_physical_device *pdev)
+{
+   const char *name = pdev->instance->app_info.app_name;
+   return name && strcmp(name, "DOOMEternal") == 0;
+}
+
 static uint64_t
 kk_physical_device_compiler_flags(const struct kk_physical_device *pdev)
 {
    return (uint64_t)pdev->info.gpu_apple_family |
-          ((uint64_t)pdev->info.msl_version << 32);
+          ((uint64_t)pdev->info.msl_version << 32) |
+          ((uint64_t)kk_doom_invariant_position(&pdev->vk) << 31);
 }
 
